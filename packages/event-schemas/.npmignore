# Read only by a standalone pack of this workspace (`npm pack -w event-schemas`), where it
# replaces the root .gitignore that lists packages/*/dist/, so dist/ ships. The root
# tarball never reads it: with root "workspaces", npm-packlist reads no ignore file
# below the root, so the root "files" list (packages/ plus its negations) decides.
node_modules/
src/
tsconfig.json
