#!/usr/bin/env bash
# obsidian — CLI bridge to Obsidian via Local REST API
#
# Usage:
#   bin/obsidian open <note-path>         Open a note in Obsidian
#   bin/obsidian read <note-path>         Read note content via API
#   bin/obsidian search <query>           Search vault
#   bin/obsidian command <command-id>     Execute an Obsidian command
#   bin/obsidian commands                 List available commands
#   bin/obsidian status                   Check if API is reachable
#   bin/obsidian active                   Get currently active file
#   bin/obsidian launch                   Open the vault in Obsidian
#   bin/obsidian help                     Show this help
#
# Requires: Obsidian running with Local REST API plugin enabled
# Vault root, API key file and API port: vaultPath / apiKeyFile / apiPort in
# ~/.openclaw/config/obsidian-sync.json (as obsidian-sync.mjs reads them).
# OBSIDIAN_API_KEY overrides the key file, OBSIDIAN_API_PORT the port.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OC_WORKSPACE="${OPENCLAW_WORKSPACE:-$(dirname "$SCRIPT_DIR")}"
# Not OBSIDIAN_VAULT_PATH: that names the memory pipeline's subtree inside the
# vault (lib/obsidian-vault.mjs getVaultPath), not the vault root.
{ read -r VAULT_PATH; read -r API_KEY_FILE; read -r CONFIG_API_PORT; } < <(OPENCLAW_WORKSPACE="$OC_WORKSPACE" node --input-type=module -e '
  const { pathToFileURL } = await import("node:url");
  const v = await import(pathToFileURL(process.argv[1]).href);
  console.log(v.getObsidianVaultRoot());
  console.log(v.getObsidianApiKeyFile());
  console.log(v.getObsidianApiPort());
' "$SCRIPT_DIR/../lib/obsidian-vault.mjs")
API_PORT="${OBSIDIAN_API_PORT:-$CONFIG_API_PORT}"
API_BASE="https://127.0.0.1:${API_PORT}"
if [ "$(uname -s)" = Darwin ]; then OPENER=open; else OPENER=xdg-open; fi

uri_quote() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$1"
}

# Load API key
if [ -n "${OBSIDIAN_API_KEY:-}" ]; then
  API_KEY="$OBSIDIAN_API_KEY"
elif [ -f "$API_KEY_FILE" ]; then
  API_KEY=$(cat "$API_KEY_FILE")
else
  API_KEY=""
fi

api_call() {
  local method="$1" endpoint="$2"
  shift 2
  curl -sk -X "$method" \
    -H "Authorization: Bearer $API_KEY" \
    -H "Content-Type: application/json" \
    "${API_BASE}${endpoint}" "$@" 2>/dev/null
}

cmd_status() {
  local resp
  resp=$(api_call GET "/" || echo "UNREACHABLE")
  if echo "$resp" | grep -q "authenticated"; then
    echo "Obsidian API: connected (port $API_PORT)"
    return 0
  elif echo "$resp" | grep -q "UNREACHABLE"; then
    echo "Obsidian API: not reachable on port $API_PORT"
    echo "  → Is Obsidian running with Local REST API enabled?"
    return 1
  else
    echo "Obsidian API: reachable but auth may be needed"
    echo "  → Set OBSIDIAN_API_KEY or save key to $API_KEY_FILE"
    return 1
  fi
}

cmd_open() {
  local note_path="$1"
  # Try API first
  if api_call POST "/open/${note_path}" -f > /dev/null 2>&1; then
    echo "Opened: $note_path"
  else
    # Fallback to URI scheme: Obsidian opens the registered vault holding this path
    "$OPENER" "obsidian://open?path=$(uri_quote "$VAULT_PATH/$note_path")"
    echo "Opened via URI: $note_path"
  fi
}

cmd_read() {
  local note_path="$1"
  api_call GET "/vault/${note_path}"
}

cmd_search() {
  local query="$1"
  api_call POST "/search/simple/" -G --data-urlencode "query=$query"
}

cmd_command() {
  local command_id="$1"
  api_call POST "/commands/${command_id}/"
}

cmd_commands() {
  api_call GET "/commands/"
}

cmd_active() {
  api_call GET "/active/"
}

cmd_launch() {
  "$OPENER" "obsidian://open?path=$(uri_quote "$VAULT_PATH")"
  echo "Opening vault in Obsidian..."
  echo "After Obsidian loads:"
  echo "  1. Go to Settings → Community Plugins → Enable 'Local REST API'"
  echo "  2. Copy the API key from the plugin settings"
  echo "  3. Run: echo 'YOUR_KEY' > $API_KEY_FILE"
  echo "  4. Test: bin/obsidian status"
}

cmd_help() {
  sed -n '2,/^$/p' "$0" | sed 's/^# //' | sed 's/^#//'
}

# --- Main ---
ACTION="${1:-help}"
shift || true

case "$ACTION" in
  status)   cmd_status ;;
  open)     cmd_open "${1:?Usage: bin/obsidian open <note-path>}" ;;
  read)     cmd_read "${1:?Usage: bin/obsidian read <note-path>}" ;;
  search)   cmd_search "${1:?Usage: bin/obsidian search <query>}" ;;
  command)  cmd_command "${1:?Usage: bin/obsidian command <command-id>}" ;;
  commands) cmd_commands ;;
  active)   cmd_active ;;
  launch)   cmd_launch ;;
  help|-h|--help) cmd_help ;;
  *) echo "Unknown command: $ACTION"; cmd_help; exit 1 ;;
esac
