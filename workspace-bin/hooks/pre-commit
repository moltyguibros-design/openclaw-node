#!/usr/bin/env bash
# pre-commit hook — Skill Security Gate
# Scans staged skill directories for dangerous patterns before allowing commit.
# Set SKIP_SKILL_SCAN=1 to bypass.

set -euo pipefail

# ── Bypass ────────────────────────────────────────────────────────────────────
if [ "${SKIP_SKILL_SCAN:-0}" = "1" ]; then
  exit 0
fi

# ── Locate scanner ────────────────────────────────────────────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
SCANNER="$REPO_ROOT/skills/openclaw-skill-scanner/scanner.py"

if [ ! -f "$SCANNER" ]; then
  exit 0
fi

# ── Identify changed skill directories ────────────────────────────────────────
# skills/_quarantine/ is never installed or deployed; scanning it would block
# moving an already-dangerous skill out of the shipped tree.
CHANGED_SKILLS=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^skills/' \
  | grep -vE '^skills/_quarantine/' \
  | sed 's|^skills/\([^/]*\)/.*|\1|' \
  | sort -u) || true

if [ -z "$CHANGED_SKILLS" ]; then
  exit 0
fi

# ── Scan each changed skill ──────────────────────────────────────────────────
BLOCKED=0
WARNED=0

for skill_name in $CHANGED_SKILLS; do
  # Skip self (the scanner itself)
  if [ "$skill_name" = "openclaw-skill-scanner" ] || [ "$skill_name" = "_quarantine" ]; then
    continue
  fi

  # Skip if directory no longer exists (deleted skill)
  if [ ! -d "$REPO_ROOT/skills/$skill_name" ]; then
    continue
  fi

  # scanner.py exits 1 exactly when a skill is dangerous (or missing), so its
  # status is not an error signal; the JSON decides. The default --dir is the
  # deployed ~/.openclaw tree, not the tree being committed.
  SCAN_OUTPUT=$(python3 "$SCANNER" --dir "$REPO_ROOT/skills" --skill "$skill_name" --json 2>/dev/null) || true

  # No parseable report fails closed: an unscanned skill must not pass.
  RISK_SCORE=$(python3 -c "
import json, sys
try:
    print(int(json.loads(sys.argv[1])['skills'][0]['risk_score']))
except Exception:
    print('unscanned')
" "$SCAN_OUTPUT" 2>/dev/null) || RISK_SCORE=unscanned

  if [ "$RISK_SCORE" = "unscanned" ]; then
    echo "BLOCKED: skills/$skill_name — the scanner produced no report"
    BLOCKED=1
    continue
  fi

  if [ "$RISK_SCORE" -ge 70 ]; then
    echo "BLOCKED: skills/$skill_name — risk_score $RISK_SCORE/100 (dangerous)"
    BLOCKED=1
  elif [ "$RISK_SCORE" -ge 30 ]; then
    echo "WARNING: skills/$skill_name — risk_score $RISK_SCORE/100 (suspicious)"
    WARNED=1
  fi
done

# ── Final verdict ─────────────────────────────────────────────────────────────
if [ "$BLOCKED" -eq 1 ]; then
  echo ""
  echo "Commit blocked by skill security gate."
  echo "Fix the flagged skills or run: SKIP_SKILL_SCAN=1 git commit ..."
  exit 1
fi

if [ "$WARNED" -eq 1 ]; then
  echo "Proceeding with warnings."
fi

exit 0
