#!/usr/bin/env node
// ClawVault access control: may <soul-id> read or write <category>?
// The rule is the soul's own capabilities.json permissions.memory, applied by
// lib/soul-memory-access.mjs (installed beside this bin as ../lib). Prints GRANTED and
// exits 0, or prints DENIED: <reason> and exits 1. clawvault-local calls it for a soul context.
//
// Usage: clawvault-access-control <soul-id> <shared|handoffs|private/<soul>|vault> [read|write]

const path = require('path');
const { pathToFileURL } = require('url');

const [soulId, category, action = 'read'] = process.argv.slice(2);
if (!soulId || !category) {
  console.log('Usage: clawvault-access-control <soul-id> <shared|handoffs|private/<soul>|vault> [read|write]');
  process.exit(1);
}

import(pathToFileURL(path.join(__dirname, '..', 'lib', 'soul-memory-access.mjs')).href)
  .then(({ checkSoulMemoryAccess }) => {
    const { granted, reason } = checkSoulMemoryAccess({ soulId, category, action });
    console.log(granted ? 'GRANTED' : `DENIED: ${reason}`);
    process.exit(granted ? 0 : 1);
  })
  .catch((err) => {
    console.log(`DENIED: access check unavailable: ${err.message}`);
    process.exit(1);
  });
