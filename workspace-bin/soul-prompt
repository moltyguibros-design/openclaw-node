#!/usr/bin/env bash
# soul-prompt — Assemble a soul-enriched preamble for Task tool spawning
#
# Usage:
#   bin/soul-prompt <soul-id> [--task-id T-xxx] [--extra-context "..."]
#
# Outputs:
#   stdout: the assembled prompt preamble
#   stderr: the recommended subagent_type (general-purpose or Explore)

set -euo pipefail

WORKSPACE="$(cd "$(dirname "$0")/.." && pwd)"
SOULS_DIR="${HOME}/.openclaw/souls"
HANDOFFS_DIR="${HOME}/.openclaw/workspace/memory-vault/handoffs"

# --- Parse args ---
SOUL_ID=""
TASK_ID=""
EXTRA_CONTEXT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --task-id)
      TASK_ID="$2"
      shift 2
      ;;
    --extra-context)
      EXTRA_CONTEXT="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      SOUL_ID="$1"
      shift
      ;;
  esac
done

if [[ -z "$SOUL_ID" ]]; then
  echo "Usage: soul-prompt <soul-id> [--task-id T-xxx] [--extra-context \"...\"]" >&2
  exit 1
fi

if [[ -n "$TASK_ID" && ! "$TASK_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "ERROR: invalid task id '${TASK_ID}'" >&2
  exit 1
fi

SOUL_DIR="${SOULS_DIR}/${SOUL_ID}"

if [[ ! -d "$SOUL_DIR" ]]; then
  echo "ERROR: Soul '${SOUL_ID}' not found at ${SOUL_DIR}" >&2
  exit 1
fi

# --- Genes + constraints markdown on stdout, subagent_type on stderr ---
CAPS_FILE="${SOUL_DIR}/capabilities.json"
GENES_FILE="${SOUL_DIR}/evolution/genes.json"

# Each section degrades on its own, so a malformed genes.json cannot drop the
# soul's Restricted Actions.
META=$(mktemp "${TMPDIR:-/tmp}/soul-prompt-meta.XXXXXX")
PARSED=$(python3 -B - "$CAPS_FILE" "$GENES_FILE" 2>"$META" <<'PY'
import json, os, sys

caps_file, genes_file = sys.argv[1:3]
MALFORMED = (OSError, ValueError, AttributeError, TypeError)


def load(path):
    if not os.path.isfile(path):
        return None
    with open(path) as f:
        return json.load(f)


subagent_type = 'general-purpose'
constraints = []
try:
    caps = load(caps_file)
    if caps is not None:
        tools = caps.get('tools', [])
        if not any(t in tools for t in ('Write', 'Edit', 'Bash')):
            subagent_type = 'Explore'
        perms = caps.get('permissions', {})
        memory = perms.get('memory', {})
        restricted = perms.get('restrictedActions', [])
        if memory or restricted or tools:
            constraints += ['---', '', '# Operational Constraints', '']
            if memory:
                constraints.append('## Memory Access')
                constraints += [f'- **{k}:** {v}' for k, v in memory.items()]
                constraints.append('')
            if restricted:
                constraints.append('## Restricted Actions (DO NOT execute these)')
                constraints += [f'- {r}' for r in restricted]
                constraints.append('')
            if tools:
                constraints += ['## Available Tools', ', '.join(tools), '']
except MALFORMED as err:
    constraints = ['---', '', '# Operational Constraints', '',
                   f'Unavailable: capabilities.json unreadable ({err}). Treat every destructive action as restricted.', '']
print('SUBAGENT_TYPE=' + subagent_type, file=sys.stderr)

genes_out = []
try:
    data = load(genes_file)
    genes = data.get('genes', []) if data is not None else []
    if genes:
        genes_out += ['---', '', '# Learned Patterns (apply these during analysis)', '']
        for gene in genes:
            if not isinstance(gene, dict):
                continue
            genes_out.append(f"## {gene.get('id', '?')}")
            genes_out.append(f"**Category:** {gene.get('category', 'unknown')}")
            genes_out.append(f"**Signal:** {gene.get('signal', '')}")
            genes_out += [f'  - {p}' for p in gene.get('preconditions', [])]
            strategy = gene.get('strategy', [])
            if strategy:
                genes_out.append('**Strategy:**')
                genes_out += [f'  1. {s}' for s in strategy]
            genes_out.append('')
except MALFORMED as err:
    genes_out = ['---', '', '# Learned Patterns', '', f'Unavailable: genes.json unreadable ({err})', '']

print('\n'.join(genes_out + constraints))
PY
) || true

SUBAGENT_TYPE=$(sed -n 's/^SUBAGENT_TYPE=//p' "$META")
rm -f "$META"
[[ -n "$SUBAGENT_TYPE" ]] || SUBAGENT_TYPE=general-purpose
echo "$SUBAGENT_TYPE" >&2

# --- Assemble preamble ---

# 1. Identity (SOUL.md) — static
SOUL_MD="${SOUL_DIR}/SOUL.md"
if [[ -f "$SOUL_MD" ]]; then
  echo "# Soul Identity"
  echo ""
  cat "$SOUL_MD"
  echo ""
fi

# 2. Principles (PRINCIPLES.md) — static
PRINCIPLES_MD="${SOUL_DIR}/PRINCIPLES.md"
if [[ -f "$PRINCIPLES_MD" ]]; then
  echo "---"
  echo ""
  echo "# Decision Principles"
  echo ""
  cat "$PRINCIPLES_MD"
  echo ""
fi

# 3-4. Genes + Constraints (from single Python call above)
if [[ -n "$PARSED" ]]; then
  echo "$PARSED"
fi

# 5. Handoff context (if task-id provided), only for a soul whose
# capabilities.json lets it read handoffs/; an access check that cannot run withholds it.
if [[ -n "$TASK_ID" ]]; then
  ACCESS=$(OPENCLAW_SOULS_DIR="$SOULS_DIR" "$WORKSPACE/bin/clawvault-access-control" "$SOUL_ID" handoffs read 2>/dev/null) || true
  HANDOFF_DOC="${HANDOFFS_DIR}/${TASK_ID}-handoff.md"
  if [[ "$ACCESS" != GRANTED* ]]; then
    REASON="${ACCESS#DENIED: }"
    echo "---"
    echo ""
    echo "# Task Handoff Context"
    echo ""
    echo "Withheld: ${REASON:-access check unavailable}"
    echo ""
  elif [[ -f "$HANDOFF_DOC" ]]; then
    echo "---"
    echo ""
    echo "# Task Handoff Context"
    echo ""
    cat "$HANDOFF_DOC"
    echo ""
  fi
fi

# 6. Extra context
if [[ -n "$EXTRA_CONTEXT" ]]; then
  echo "---"
  echo ""
  echo "# Additional Context"
  echo ""
  echo "$EXTRA_CONTEXT"
  echo ""
fi

# 7. Trust tier + autonomy level (from trust-registry)
TRUST_REGISTRY="${WORKSPACE}/.tmp/trust-registry.json"
if [[ -f "$TRUST_REGISTRY" ]]; then
  # trust-registry owns the scoring; -B keeps the import from writing a
  # __pycache__ into the workspace bin/.
  TRUST_INFO=$(python3 -B - "${WORKSPACE}/bin/trust-registry" "$SOUL_ID" 2>/dev/null <<'PY' || echo "Trust: 0.500 | Tier: new | Autonomy: atomic | Track record: 0/0"
import sys, importlib.util
from importlib.machinery import SourceFileLoader
loader = SourceFileLoader('trust_registry', sys.argv[1])
tr = importlib.util.module_from_spec(importlib.util.spec_from_loader('trust_registry', loader))
loader.exec_module(tr)
s = tr.load_registry()['souls'].get(sys.argv[2], {})
trust = tr.compute_trust(s)
tier = tr.compute_tier(s, trust)
print(f"Trust: {trust:.3f} | Tier: {tier} | Autonomy: {tr.TIERS[tier]['max_autonomy']} | Track record: {s.get('tasks_succeeded', 0)}/{s.get('tasks_total', 0)}")
PY
)
  echo "---"
  echo ""
  echo "# Delegation Trust"
  echo ""
  echo "$TRUST_INFO"
  echo ""
fi

# 7b. Circuit breaker check
# Exit 1 is the only "blocked" answer: HALF_OPEN with a probe allowed exits 0,
# and a missing registry (127) must not warn.
CB_RC=0
"$WORKSPACE/bin/trust-registry" check "${SOUL_ID}" >/dev/null 2>&1 || CB_RC=$?
if [[ "$CB_RC" -eq 1 ]]; then
  echo "---"
  echo ""
  echo "# ⚡ Circuit Breaker Warning"
  echo ""
  echo "This soul's circuit breaker is OPEN due to consecutive failures."
  echo "Delegation is not recommended. Consider using an alternative soul."
  echo ""
fi

# 8. Standard completion protocol + contract template
echo "---"
echo ""
echo "# Completion Protocol"
echo ""
echo "- When done: report what was accomplished concisely"
echo "- If blocked: surface the blocker immediately — do not spiral or guess"
echo "- Do not add scope beyond what was asked"
echo "- Prefer editing existing files over creating new ones"
echo "- Security-first: no secrets in output, no destructive commands without confirmation"
echo "- No writing to genome files (SOUL.md, PRINCIPLES.md, AGENTS.md, MEMORY.md)"
echo ""
echo "## Contract (delegator fills this in)"
echo ""
echo "- **Deliverable:** [to be specified]"
echo "- **Verification:** [to be specified] + \`bin/quality-gate --files <changed-files>\` exits 0 or 2"
echo "- **Boundaries:** [to be specified]"
echo "- **Budget:** 15 turns max (default)"
echo "- **Criticality:** normal | high"
echo "- **Escalation:** Report blocker immediately, do not retry more than once"
echo "- **Quality Gate:** Run \`bin/quality-gate --files <changed-files>\` before reporting done"
echo "- **Screenshot Gate:** If modifying UI files (*.tsx/*.jsx in components/pages/app/, *.css), include visual evidence in artifacts"
