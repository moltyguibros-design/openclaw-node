+class ProbeRelease(unittest.TestCase):
+    """The probe's cleanup, scripted: its own attach disks are ejected and confirmed gone even when the
+    inventory does not list them."""
+
+    def release(self, eject_works):
+        present, commands = {'/dev/disk7'}, []
+
+        def scripted(*argv, **options):
+            commands.append(list(argv))
+            row = {'argv': list(argv), 'returncode': 0, 'timed_out': False, 'stdout': b'', 'stderr': ''}
+            if argv[:2] == (DISKUTIL, 'eject'):
+                if not eject_works:
+                    return {**row, 'returncode': 1}
+                present.discard(argv[2])
+            if argv[:3] == (DISKUTIL, 'info', '-plist'):
+                return {**row, 'returncode': 0 if argv[3] in present else 1}
+            return row
+
+        with mock.patch.object(probe, 'attempt', side_effect=scripted), \
+                mock.patch.object(probe, 'attachments', return_value=[]), \
+                mock.patch('subprocess.run', side_effect=AssertionError('command run')):
+            found = probe.release(pathlib.Path('/nonexistent/probe.asif'), [], ['/dev/disk7', '/dev/disk7'])
+        return found, commands
+
+    def test_an_inventory_blind_to_its_own_attach_is_still_ejected_and_confirmed_gone(self):
+        found, commands = self.release(eject_works=True)
+        self.assertEqual(commands, [[DISKUTIL, 'info', '-plist', '/dev/disk7'], [DISKUTIL, 'eject', '/dev/disk7'],
+                                    [DISKUTIL, 'info', '-plist', '/dev/disk7']])
+        self.assertEqual((found['disks_gone'], found['clean']), ([True], True))
+        found, commands = self.release(eject_works=False)
+        self.assertEqual([argv for argv in commands if argv[:2] == [DISKUTIL, 'eject']],
+                         [[DISKUTIL, 'eject', '/dev/disk7']] * wrapper.EJECT_ATTEMPTS)
