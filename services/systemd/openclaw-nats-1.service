[Unit]
Description=OpenClaw NATS Node 1 — R=3 cluster (client 4222, cluster 6222, monitor 8222)
After=network.target

[Service]
Type=simple
ExecStart="${NATS_SERVER_BIN}" --config "${OPENCLAW_ROOT}/config/nats-1.conf"
# SIGHUP re-reads authorization (nats-auth.conf) without dropping healthy clients.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
Environment="HOME=${HOME}"
StandardOutput=append:${OPENCLAW_ROOT}/logs/nats-1.log
StandardError=append:${OPENCLAW_ROOT}/logs/nats-1.err

[Install]
WantedBy=default.target
