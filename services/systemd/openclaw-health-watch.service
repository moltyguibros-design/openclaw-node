[Unit]
Description=OpenClaw Health Watch — polls memory infrastructure components every 60s
After=network.target

[Service]
Type=simple
ExecStart=${NODE_BIN} ${OPENCLAW_WORKSPACE}/bin/health-watch.mjs
Restart=always
RestartSec=30
Environment=HOME=${HOME}
Environment=PATH=${HOME}/.openclaw/workspace/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_PATH=${OPENCLAW_REPO_DIR}/node_modules:${OPENCLAW_WORKSPACE}/node_modules
Environment=OPENCLAW_NATS=${OPENCLAW_NATS}
Environment=OPENCLAW_WORKSPACE=${OPENCLAW_WORKSPACE}
Environment=OPENCLAW_NODE_ID=${OPENCLAW_NODE_ID}
Environment=LLM_MODEL=${LLM_MODEL}
Environment=LLM_BASE_URL=${LLM_BASE_URL}
Environment=HEALTH_WATCH_INTERVAL_SEC=60
Environment=TZ=${OPENCLAW_TIMEZONE}
WorkingDirectory=${OPENCLAW_WORKSPACE}
StandardOutput=append:${OPENCLAW_WORKSPACE}/.tmp/openclaw-health-watch.log
StandardError=append:${OPENCLAW_WORKSPACE}/.tmp/openclaw-health-watch.err

[Install]
WantedBy=default.target
